# Copy this file to backend/.env and fill in the values.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=research_bridge
DB_USER=rb_app
DB_PASSWORD=rb_local_dev

# --- OpenAlex ingestion ---
OPENALEX_BASE_URL=https://api.openalex.org
# Optional: a contact email puts requests in OpenAlex's faster "polite pool".
# Leave blank to run anonymously.
OPENALEX_MAILTO=

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
